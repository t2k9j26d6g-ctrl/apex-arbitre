:root{--bg:#f3f5f7;--card:#fff;--ink:#172126;--muted:#687780;--line:#dfe5e8;--nav:#102e34;--nav2:#173b42;--accent:#27737d;--soft:#eaf2f3;--green:#24724d;--greenbg:#eaf6ef;--orange:#9a6415;--orangebg:#fff4df;--red:#a34242;--redbg:#fbeaea}*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}button,input,textarea{font:inherit}.topbar{height:76px;background:var(--nav);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 28px;box-shadow:0 2px 12px #0002}.brand{font-size:27px;font-weight:900;letter-spacing:.07em}.brand span{font-weight:500;opacity:.65;font-size:13px}.subtitle{font-size:10px;letter-spacing:.12em;opacity:.66}.top-right{display:flex;gap:10px;align-items:center}.version,.countdown{font-size:11px;padding:7px 10px;border:1px solid #ffffff33;border-radius:99px}.countdown{background:#ffffff12}.layout{display:grid;grid-template-columns:245px 1fr;min-height:calc(100vh - 76px)}.sidebar{background:var(--nav2);padding:20px 13px;display:flex;flex-direction:column;gap:6px}.nav{border:0;background:transparent;color:#d3e1e3;text-align:left;padding:13px 14px;border-radius:10px;cursor:pointer}.nav:hover,.nav.active{background:#ffffff14;color:#fff}.aside-note{margin-top:auto;font-size:10px;line-height:1.5;color:#abc0c3;padding:12px}.content{padding:30px;max-width:1370px;width:100%}.view{display:none}.view.active{display:block}.hero{background:linear-gradient(135deg,#13363c,#29666f);color:#fff;border-radius:20px;padding:32px 34px;display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:18px}.hero h1{font-size:34px;margin:7px 0}.hero p{color:#d7e4e6;max-width:760px;line-height:1.5}.hero-btn,.primary,.ghost{border:0;border-radius:10px;padding:12px 16px;font-weight:800;cursor:pointer}.hero-btn{background:#fff;color:#173b42}.primary{background:var(--accent);color:#fff}.ghost{background:#e9edef;color:#33474e}.eyebrow{font-size:10px;letter-spacing:.16em;font-weight:900;color:#769aa0}.hero .eyebrow{color:#add0d4}.section-head,.panel-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px}.section-head{margin-bottom:20px}.section-head h1{font-size:30px;margin:4px 0}.section-head p{margin:7px 0 0;color:var(--muted)}.panel{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:22px;margin-bottom:18px}.panel h2{margin:0 0 14px}.dashboard-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.metric{background:#f7f9fa;border-radius:11px;padding:13px;display:flex;gap:10px;align-items:center}.metric i{font-style:normal;font-size:21px}.metric b,.metric span{display:block}.metric b{font-size:17px}.metric span{font-size:10px;color:var(--muted);margin-top:2px}.badge{display:inline-block;background:var(--soft);color:#2a5d64;border-radius:99px;padding:6px 9px;font-size:10px;font-weight:900}.badge.green{background:var(--greenbg);color:var(--green)}.badge.orange{background:var(--orangebg);color:var(--orange)}.badge.red{background:var(--redbg);color:var(--red)}.badge.neutral{background:#eef1f2;color:#687780}.pillar-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.pillar-grid article{background:#f7f9fa;border-radius:12px;padding:18px;font-size:22px}.pillar-grid b,.pillar-grid span{display:block}.pillar-grid b{font-size:14px;margin:9px 0 5px}.pillar-grid span{font-size:11px;color:var(--muted);line-height:1.4}.decision-main,.decision{border-radius:16px;padding:22px;margin-bottom:18px;display:flex;gap:16px;align-items:center}.decision-main{background:#fff;border:1px solid var(--line)}.decision-main.green,.decision.green{background:var(--greenbg);border-color:#cce6d6}.decision-main.orange,.decision.orange{background:var(--orangebg);border-color:#f0d7ac}.decision-main.red,.decision.red{background:var(--redbg);border-color:#efc8c8}.decision-main.neutral{background:#fff}.status-dot{width:13px;height:13px;border-radius:50%;background:#9aa6ab;align-self:flex-start;margin-top:5px}.green .status-dot{background:var(--green)}.orange .status-dot{background:var(--orange)}.red .status-dot{background:var(--red)}.decision-copy{flex:1}.decision-copy h2,.decision h2{margin:5px 0 4px;font-size:23px}.decision-copy p,.decision p{margin:0;color:#4e5c63}.decision-session{display:flex;gap:11px;align-items:center;margin-top:14px}.decision-session b,.decision-session small{display:block}.decision-session small{color:var(--muted);margin-top:2px}.code{display:inline-flex;min-width:43px;height:34px;border-radius:9px;background:#173b42;color:#fff;align-items:center;justify-content:center;font-weight:900;font-size:13px;padding:0 9px}.big-score,.decision-score{margin-left:auto;text-align:center}.big-score b,.decision-score b{display:block;font-size:38px}.big-score span,.decision-score span{font-size:10px;color:var(--muted)}.goal-ring{width:82px;height:82px;border:8px solid var(--soft);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;float:left;margin-right:18px}.goal-ring b{font-size:21px}.goal-ring span{font-size:8px;color:var(--muted)}.muted{color:var(--muted)}.checkin-grid,.grid2{display:grid;gap:14px}.checkin-grid{grid-template-columns:repeat(4,1fr)}.grid2{grid-template-columns:1fr 1fr}label{font-size:11px;font-weight:800;color:#42545c}input,textarea{width:100%;margin-top:6px;border:1px solid #cad5da;border-radius:9px;padding:10px;background:#fff;color:var(--ink)}textarea{min-height:80px;resize:vertical}.actions{display:flex;justify-content:flex-end;margin-top:12px}.hidden{display:none!important}.recommend{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding:18px 0}.recommend>div{display:grid;grid-template-columns:auto 1fr;column-gap:12px}.recommend h3,.recommend p{grid-column:2;margin:0 0 5px}.reasonline,.medical-note{font-size:11px;padding:12px;border-radius:9px;background:#f7f9fa;color:#55636a;margin-top:8px}.medical-note{border-left:3px solid #95a6ac}.timeline{display:flex;flex-direction:column;gap:9px}.plan-row{position:relative;display:grid;grid-template-columns:72px 58px 1fr auto;align-items:center;gap:13px;background:#fff;border:1px solid var(--line);border-radius:13px;padding:13px 16px}.plan-row.today{border:2px solid var(--accent);box-shadow:0 5px 20px #1f5f6715}.plan-row.past{opacity:.55}.plan-row.test{border-color:#c7d4d8}.datebox{text-align:center}.datebox b,.datebox span{display:block}.datebox b{font-size:15px}.datebox span{text-transform:uppercase;font-size:9px;color:var(--muted)}.plan-code{font-size:18px;font-weight:900;color:#2f6971}.plan-body h3{margin:0 0 4px;font-size:14px}.plan-body p{margin:0 0 5px;font-size:11px;color:#536168}.plan-body small{color:#8a969b}.today-chip{font-size:9px;background:var(--soft);padding:6px 8px;border-radius:99px;color:#2a5d64;font-weight:900}.library-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:13px}.lib-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px}.lib-top{display:flex;justify-content:space-between}.lib-card h2{font-size:16px;margin:13px 0 5px}.lib-card p{font-size:12px;line-height:1.5;color:#526168}.tag,.tagrow span{display:inline-block;background:var(--soft);border-radius:99px;padding:5px 8px;font-size:9px;color:#305e64}.purpose,.knee{font-size:10px;background:#f7f9fa;padding:10px;border-radius:8px;margin-top:10px;line-height:1.5}.purpose b,.knee b{display:block;margin-bottom:3px}.knee{background:#fbf7ef}.cards{display:grid;gap:13px}.stats{grid-template-columns:repeat(4,1fr);margin-bottom:18px}.stats article,.list article{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px}.stats span{display:block;font-size:29px;font-weight:900}.stats small{color:var(--muted)}.spark{height:130px;display:flex;align-items:flex-end;gap:7px;padding-top:10px}.spark i{flex:1;max-width:30px;background:#568c94;border-radius:5px 5px 2px 2px;min-height:6px}.spark-labels{display:flex;justify-content:space-between;font-size:9px;color:var(--muted)}.log-row{display:grid;grid-template-columns:100px 1fr auto;gap:15px;padding:11px 0;border-top:1px solid var(--line);font-size:12px}.log-row:first-child{border-top:0}.log-row small{color:var(--muted)}.mental-intro p{color:#526168}.tagrow{display:flex;gap:7px;flex-wrap:wrap}.history-head{display:flex;justify-content:space-between}.list{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}.list h2{font-size:16px;margin:12px 0 7px}.list p{font-size:12px;color:#536168}.empty{text-align:center;color:var(--muted);padding:28px}.meta{font-size:10px;color:var(--muted)}@media(max-width:930px){.layout{grid-template-columns:1fr}.sidebar{flex-direction:row;overflow:auto;padding:8px}.aside-note{display:none}.content{padding:16px}.dashboard-grid,.grid2,.checkin-grid,.metric-grid,.pillar-grid,.stats{grid-template-columns:1fr 1fr}.hero,.section-head{align-items:flex-start;flex-direction:column}.plan-row{grid-template-columns:55px 45px 1fr}.today-chip{display:none}}@media(max-width:600px){.dashboard-grid,.grid2,.checkin-grid,.metric-grid,.pillar-grid,.stats{grid-template-columns:1fr}.topbar{padding:0 14px}.brand{font-size:20px}.subtitle{display:none}.content{padding:11px}.hero{padding:23px}.hero h1{font-size:27px}.plan-row{grid-template-columns:45px 42px 1fr;padding:11px}.recommend{flex-direction:column}.log-row{grid-template-columns:1fr}}


/* V1.3 — bibliothèque compacte + fiche séance unique */
.plan-row{cursor:pointer;transition:.15s ease}.plan-row:hover{transform:translateY(-1px);box-shadow:0 7px 20px #15383f12;border-color:#b8cbd0}.chevron{font-size:28px;color:#94a4aa;font-weight:300}.library-grid{grid-template-columns:repeat(auto-fit,minmax(285px,1fr));gap:14px}.lib-card.compact{cursor:pointer;min-height:205px;display:flex;flex-direction:column;transition:.16s ease;padding:18px}.lib-card.compact:hover{transform:translateY(-2px);box-shadow:0 8px 24px #16394113;border-color:#bdd0d4}.lib-card.compact h2{font-size:17px;margin:14px 0 8px}.lib-summary{margin:0!important;font-size:12px!important;line-height:1.45!important;color:#5b6970!important;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.lib-footer{margin-top:auto;padding-top:16px;border-top:1px solid #edf1f2;display:grid;grid-template-columns:1fr auto;gap:7px 12px;align-items:center;font-size:10px;color:var(--muted)}.lib-footer b{grid-column:1/-1;color:#2a6871;font-size:11px}.domyos-chip{background:#eef5f6;color:#2a626a;border-radius:99px;padding:5px 7px}.session-modal{position:fixed;inset:0;background:#0d252bcc;z-index:1000;display:none;align-items:flex-start;justify-content:center;padding:28px;overflow:auto}.session-modal.open{display:flex}.modal-open{overflow:hidden}.session-modal-card{width:min(920px,100%);background:#fff;border-radius:20px;box-shadow:0 24px 80px #0006;padding:28px;margin:auto}.session-sheet-head{display:flex;justify-content:space-between;align-items:center}.session-sheet-head>div{display:flex;gap:9px;align-items:center}.code.large{height:42px;min-width:52px;font-size:16px}.modal-close{border:0;background:#edf1f2;width:38px;height:38px;border-radius:50%;font-size:27px;line-height:1;color:#536168;cursor:pointer}.session-modal-card h1{font-size:29px;margin:15px 0 10px}.session-facts{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.session-facts span{background:#f5f7f8;border:1px solid #e7ecee;border-radius:99px;padding:8px 11px;font-size:11px;color:#526168}.session-summary{font-size:14px;line-height:1.55;color:#536168;margin-bottom:20px}.domyos-box,.steps-box{background:#f8fafb;border:1px solid #e4eaec;border-radius:14px;padding:18px;margin:18px 0}.domyos-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:12px}.domyos-head h2{margin:3px 0 0;font-size:20px}.program-table-wrap{overflow:auto;border-radius:10px;border:1px solid #e0e6e8}.program-table{width:100%;border-collapse:collapse;min-width:560px;background:white}.program-table th,.program-table td{text-align:left;padding:11px 12px;border-bottom:1px solid #edf1f2;font-size:12px}.program-table th{background:#eef3f4;font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:#63737a}.program-table tr:last-child td{border-bottom:0}.program-table td:nth-child(2),.program-table td:nth-child(3),.program-table td:nth-child(4){white-space:nowrap}.domyos-note{font-size:11px;color:#59676e;line-height:1.5;margin:12px 0 0;padding-left:10px;border-left:3px solid #77a0a7}.steps-box ol{margin:10px 0 0;padding-left:22px}.steps-box li{padding:6px 0;font-size:13px;color:#526168}.session-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.session-info{background:#f7f9fa;border-radius:12px;padding:15px}.session-info.warning{background:#fbf7ef}.session-info p{font-size:12px;line-height:1.55;color:#4f5d64;margin:6px 0 0}.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:22px}
@media(max-width:650px){.session-modal{padding:0;align-items:stretch}.session-modal-card{border-radius:0;min-height:100vh;padding:19px}.session-modal-card h1{font-size:24px}.session-detail-grid{grid-template-columns:1fr}.domyos-head{align-items:flex-start;flex-direction:column}.modal-actions{position:sticky;bottom:0;background:white;padding:12px 0 0}.lib-card.compact{min-height:170px}}

/* V1.4 — saisie Domyos écran par écran + fiches Pilates */
.domyos-warning{display:flex;gap:12px;align-items:flex-start;background:#fff4df;border:1px solid #f0d7ac;border-radius:10px;padding:12px 14px;margin-bottom:14px;font-size:11px;color:#684d22}.domyos-warning b{white-space:nowrap}.domyos-warning span b{white-space:normal}.domyos-steps{display:grid;gap:10px}.domyos-step{background:#fff;border:1px solid #e0e7e9;border-radius:12px;padding:14px}.domyos-step-title{display:flex;align-items:center;gap:10px;margin-bottom:11px}.domyos-step-title>span{width:28px;height:28px;border-radius:50%;background:#173b42;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:12px}.domyos-step-title h3{margin:0;font-size:15px}.domyos-values{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px}.domyos-values>div{background:#f5f8f9;border-radius:9px;padding:10px}.domyos-values small,.domyos-values b{display:block}.domyos-values small{font-size:9px;color:#6f7d83;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}.domyos-values b{font-size:15px;color:#173b42}.domyos-step p{margin:9px 0 0;font-size:10px;color:#687780}.exercise-sheet{background:#f8fafb;border:1px solid #e4eaec;border-radius:14px;padding:18px;margin:18px 0}.exercise-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;margin-bottom:14px}.exercise-head h2{margin:3px 0 0;font-size:20px}.exercise-list{display:grid;gap:10px}.exercise-card{display:grid;grid-template-columns:36px 1fr;gap:12px;background:#fff;border:1px solid #e0e7e9;border-radius:12px;padding:13px}.exercise-num{width:32px;height:32px;border-radius:9px;background:#173b42;color:white;display:flex;align-items:center;justify-content:center;font-weight:900}.exercise-title{display:flex;justify-content:space-between;gap:12px;align-items:center}.exercise-title h3{margin:0;font-size:14px}.exercise-title b{font-size:11px;background:#eaf2f3;border-radius:99px;padding:5px 8px;white-space:nowrap}.exercise-main p{font-size:11px;line-height:1.5;color:#536168;margin:7px 0 0}.exercise-knee{background:#fbf7ef;border-left:3px solid #d2ad6f;padding:8px 9px;border-radius:6px}@media(max-width:650px){.domyos-warning,.exercise-head{flex-direction:column}.domyos-values{grid-template-columns:1fr 1fr}.exercise-card{grid-template-columns:30px 1fr}.exercise-num{width:28px;height:28px}.exercise-title{align-items:flex-start}.exercise-title h3{font-size:13px}}

/* V1.5 — apprentissage personnel + indice de préparation */
.mini{font-size:10px;margin:4px 0 0}.prep-panel{margin:18px 0}.prep-layout{display:grid;grid-template-columns:150px 1fr;gap:24px;align-items:center}.prep-total{height:128px;width:128px;border-radius:50%;background:linear-gradient(145deg,#173b42,#2d737d);color:#fff;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;align-content:center;margin:auto;box-shadow:inset 0 0 0 7px #ffffff18}.prep-total b{font-size:42px;line-height:.9}.prep-total span{font-size:14px;margin-top:15px}.prep-total small{width:100%;text-align:center;font-size:9px;opacity:.75;margin-top:5px}.prep-bars{display:grid;gap:10px}.prep-row{display:grid;gap:5px}.prep-label{display:flex;justify-content:space-between;font-size:11px;color:#526168}.prep-track{height:8px;background:#e7edef;border-radius:99px;overflow:hidden}.prep-track i{display:block;height:100%;background:#3c7d86;border-radius:99px}.prep-disclaimer{font-size:10px;color:#7a878c;margin:14px 0 0;padding-top:10px;border-top:1px solid #edf1f2}.learning-note{font-size:10px;background:#ffffff14;border:1px solid #ffffff24;border-radius:8px;padding:8px 10px;margin-top:10px;color:#d5e5e7}.learning-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.learning-card{border:1px solid #dfe6e8;border-radius:11px;padding:12px;background:#f8fafb}.learning-card>div{display:flex;align-items:center;gap:9px}.learning-card>div>b{font-size:11px}.learning-card small{display:block;color:#7a878c;margin:8px 0 4px}.learning-card p{font-size:10px;color:#536168;margin:0;line-height:1.45}.learning-card.high{background:#fff4df;border-color:#efd6aa}.learning-card.well_tolerated{background:#eaf6ef;border-color:#cce8d7}.adapt-note{background:#eef5f6;border-left:3px solid #4d8992;padding:8px;border-radius:5px;font-size:10px!important}.decision-session:hover{filter:brightness(1.03)}
@media(max-width:650px){.prep-layout{grid-template-columns:1fr}.prep-total{height:110px;width:110px}.prep-total b{font-size:36px}}


/* ===== APEX V1.6 : mobile + exécution ===== */
.execute-big{width:100%;margin:16px 0 8px;padding:16px;font-size:16px}
.visual-card{display:grid!important;grid-template-columns:46px 190px 1fr!important;gap:14px;align-items:center}
.visual-card img{width:190px;height:125px;object-fit:cover;border-radius:12px;background:#f2f5f6}
.execution-overlay{position:fixed;inset:0;background:#f6f8f9;z-index:3000;display:none;overflow:auto}
.execution-overlay.open{display:block}.execution-content{min-height:100vh;display:flex;flex-direction:column;max-width:760px;margin:0 auto;background:white;box-shadow:0 0 40px rgba(0,0,0,.08)}
.exec-head{position:sticky;top:0;z-index:2;display:grid;grid-template-columns:54px 1fr 54px;align-items:center;padding:14px 18px;border-bottom:1px solid #e1e7e9;background:#fff}.exec-head button{border:0;background:#edf3f4;border-radius:50%;width:42px;height:42px;font-size:22px}.exec-head div{display:flex;flex-direction:column;text-align:center}.exec-head small{color:#6c7b80}.exec-head b{color:#123f4a;font-size:15px}.exec-progress{height:7px;background:#e6edef;border-radius:8px;overflow:hidden;margin-bottom:18px}.exec-progress i{display:block;height:100%;background:#1f6f7a}
.pilates-exec,.domyos-exec,.debrief-form{padding:22px 24px 110px}.pilates-exec h1,.domyos-exec h1,.debrief-form h1{font-size:30px;margin:8px 0 16px;color:#102f37}.photo-frame{background:#f2f5f6;border-radius:18px;overflow:hidden;border:1px solid #dce5e7}.photo-frame img{width:100%;height:min(42vh,360px);object-fit:contain;display:block}.exec-dose{font-size:22px;font-weight:800;color:#1f6f7a;background:#eaf5f4;display:inline-block;padding:9px 14px;border-radius:999px;margin:16px 0}.pilates-exec section{padding:12px 0;border-top:1px solid #e4eaec}.pilates-exec h3{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:#557177;margin:0 0 5px}.pilates-exec p{font-size:17px;line-height:1.45;margin:0}.exec-knee{background:#fff7e9;border:1px solid #f1dbad!important;border-radius:12px;padding:14px!important;margin-top:10px}
.exec-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(760px,100%);display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:12px 18px calc(12px + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);border-top:1px solid #dde5e7;z-index:3}.exec-nav button{min-height:48px;border-radius:12px;border:1px solid #cbd8db;background:white;font-weight:700}.exec-nav button:disabled{opacity:.35}.exec-nav .primary{background:#123f4a;color:white;border-color:#123f4a}
.domyos-exec{text-align:center}.domyos-big-number{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#123f4a;color:white;font-size:28px;font-weight:800;margin:16px auto}.domyos-big-values{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:20px 0}.domyos-big-values article{border:1px solid #dce6e8;border-radius:15px;padding:18px 10px;background:#f9fbfb}.domyos-big-values small{display:block;color:#708187;margin-bottom:6px}.domyos-big-values b{font-size:25px;color:#123f4a}.exec-tip{margin-top:18px;padding:14px;border-radius:12px;background:#fff5df;color:#6e5420;text-align:left;line-height:1.4}
.debrief-form{display:grid;gap:18px}.debrief-form label{display:grid;gap:8px;font-weight:700;color:#294850}.debrief-form input[type=number],.debrief-form input[type=text],.debrief-form select,.debrief-form textarea{font:inherit;padding:13px;border:1px solid #cbd7da;border-radius:12px;background:white}.debrief-form textarea{min-height:90px}.range-label input[type=range]{width:100%;accent-color:#1f6f7a}.db-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.mobile-bottom-nav{display:none}.floating-today{position:fixed;right:22px;bottom:22px;z-index:1100;border:0;background:#123f4a;color:white;border-radius:999px;padding:12px 17px;font-weight:800;box-shadow:0 8px 24px rgba(18,63,74,.25)}.cockpit-open-session{margin-top:10px}
body.execution-open{overflow:hidden}
@media(max-width:820px){
 .topbar{padding:10px 14px}.subtitle{display:none}.top-right .countdown{font-size:12px}.layout{display:block}.sidebar{display:none}.content{padding:18px 14px 92px}.hero{grid-template-columns:1fr;padding:18px}.hero h1{font-size:28px}.hero-btn{width:100%}.dashboard-grid{grid-template-columns:1fr}.pillar-grid{grid-template-columns:1fr 1fr}.checkin-grid{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:1fr}.library-grid{grid-template-columns:1fr}.timeline{gap:8px}.plan-row{grid-template-columns:58px 48px 1fr;padding:10px}.plan-row .today-chip,.plan-row .chevron{display:none}.session-modal-card{width:100%;max-width:none;min-height:100vh;border-radius:0;margin:0}.session-modal{padding:0}.session-facts{grid-template-columns:1fr 1fr}.visual-card{grid-template-columns:40px 120px 1fr!important}.visual-card img{width:120px;height:95px}.floating-today{display:none}.mobile-bottom-nav{display:grid;position:fixed;bottom:0;left:0;right:0;z-index:1800;grid-template-columns:repeat(4,1fr);background:rgba(255,255,255,.97);border-top:1px solid #d9e2e4;padding-bottom:env(safe-area-inset-bottom)}.mobile-bottom-nav button{border:0;background:transparent;padding:9px 4px 8px;display:grid;gap:2px;place-items:center;color:#234b55;font-size:18px}.mobile-bottom-nav span{font-size:10px;font-weight:700}.execution-overlay.open~.mobile-bottom-nav{display:none}.checkin-grid input{min-height:48px;font-size:17px}.primary,.ghost{min-height:46px}.prep-layout{grid-template-columns:1fr}.exec-head{padding-top:calc(10px + env(safe-area-inset-top))}
}
@media(max-width:520px){.checkin-grid{grid-template-columns:1fr}.pillar-grid{grid-template-columns:1fr}.domyos-big-values{grid-template-columns:1fr 1fr}.domyos-big-values b{font-size:22px}.visual-card{grid-template-columns:34px 92px 1fr!important;gap:8px}.visual-card img{width:92px;height:80px}.exercise-title{display:block!important}.session-detail-grid{grid-template-columns:1fr}.debrief-form{padding-left:16px;padding-right:16px}.db-grid{grid-template-columns:1fr 1fr}}

/* ===== APEX V1.7 TEST : Supabase / multi-appareils ===== */
.cloud-top-status{font-size:10px;font-weight:900;letter-spacing:.07em;padding:6px 9px;border-radius:999px;border:1px solid #ffffff38}.cloud-top-status.local{background:#ffffff12;color:#d9e8ea}.cloud-top-status.online{background:#daf4e5;color:#1e6b45;border-color:#b9e7ce}.cloud-top-status.error{background:#fff0dd;color:#8a5a16;border-color:#f0d1a5}
.sync-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}.sync-grid label{display:grid;gap:6px;margin:12px 0;font-weight:700;color:#294850}.sync-grid input{font:inherit;padding:12px;border:1px solid #cbd7da;border-radius:10px;background:white}.cloud-user{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px;border:1px solid #dce6e8;border-radius:11px;background:#f8fafb}.cloud-user small,.cloud-user b{display:block}.cloud-user small{color:#708187;margin-bottom:3px}.cloud-result{margin-top:13px;border-radius:10px;padding:12px;font-size:11px;line-height:1.45;border:1px solid #dce5e7}.cloud-result.neutral{background:#f6f8f9;color:#607076}.cloud-result.ok{background:#eaf7ef;color:#236946;border-color:#c8e8d5}.cloud-result.warn{background:#fff6e7;color:#75551d;border-color:#efd9af}.cloud-result.error{background:#fff0ef;color:#8b3e39;border-color:#ecc8c5}.migration-preview{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:15px 0}.migration-preview article{padding:14px;border-radius:11px;background:#f6f9fa;border:1px solid #e0e7e9}.migration-preview b,.migration-preview span{display:block}.migration-preview b{font-size:25px;color:#123f4a}.migration-preview span{font-size:10px;color:#6b7a80;margin-top:4px}.cloud-safety{margin-top:14px;padding:14px;border-radius:11px;background:#eef6f7;border-left:4px solid #3d7d86}.cloud-safety p{margin:6px 0 0;font-size:11px;line-height:1.5;color:#53656b}.cloud-safety code{background:#fff;padding:2px 5px;border-radius:5px}.sync-grid code{background:#eef3f4;padding:2px 4px;border-radius:4px}
@media(max-width:820px){.sync-grid{grid-template-columns:1fr}.migration-preview{grid-template-columns:1fr 1fr}}
.cloud-remote-preview{margin-top:14px}.cloud-remote-preview:empty{display:none}
.cloud-pull-panel{margin-top:18px}.cloud-pull-panel .actions{margin-top:14px}


/* APEX V1.8 — arbitrage utilisateur */
.apex-arbitration{margin:16px 0;padding:16px;border:1px solid #d7e2e4;border-radius:14px;background:#f7fafb}.arb-compare{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:stretch}.arb-compare article{display:grid;gap:6px;align-content:start;padding:13px;border-radius:11px;background:white;border:1px solid #e1e8ea}.arb-compare article.recommended{background:#eef7f3;border-color:#cfe5d9}.arb-compare small{font-size:9px;letter-spacing:.08em;color:#75848a}.arb-compare b{font-size:12px}.arb-arrow{display:grid;place-items:center;font-size:22px;color:#6f858b}.apex-arbitration>p{font-size:11px;color:#5e7076;margin:12px 0}.arb-actions{display:flex;gap:9px;flex-wrap:wrap}.ghost.warn{border-color:#d1a96c;background:#fff8ed;color:#72501e}.choice-confirm{display:grid;gap:4px;margin:14px 0;padding:13px 15px;border-radius:11px;border-left:4px solid #378064;background:#edf7f1}.choice-confirm.refused{border-left-color:#c18a36;background:#fff7e9}.choice-confirm span,.choice-confirm small{font-size:10px;color:#607078}.cockpit-choice{margin:10px 0;padding:9px 11px;border-radius:8px;background:#ffffff15;border:1px solid #ffffff25;display:grid;gap:3px}.cockpit-choice b{font-size:10px}.cockpit-choice span{font-size:9px;opacity:.85}.cockpit-choice.refused{background:#f2b84b22;border-color:#f2b84b44}.history-choice{display:flex;flex-wrap:wrap;gap:7px;margin:8px 0}.history-choice span{background:#f1f5f6;border-radius:99px;padding:5px 8px;font-size:9px;color:#65767b}.history-choice b{color:#173b42}.user-reason{background:#fff7e9;border-left:3px solid #c18a36;padding:8px;border-radius:5px;font-size:10px!important}
@media(max-width:650px){.arb-compare{grid-template-columns:1fr}.arb-arrow{transform:rotate(90deg);height:18px}.arb-actions{display:grid}.arb-actions button{width:100%}}

/* =========================================================
   APEX V1.9 — Synchronisation automatique
   ========================================================= */
.auto-sync-panel{border:1px solid rgba(31,91,106,.22);background:linear-gradient(180deg,#fff,#f7fbfc)}
.auto-sync-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0}
.auto-sync-grid>div{padding:12px;border:1px solid #d9e6e9;border-radius:12px;background:#fff;display:flex;flex-direction:column;gap:5px}
.auto-sync-grid small{font-size:.72rem;color:#6c7d82;text-transform:uppercase;letter-spacing:.04em}
.auto-sync-grid b{font-size:.9rem;color:#123f4a;overflow-wrap:anywhere}
.cloud-top-status.syncing{background:#fff4d6;color:#805f00;border-color:#e9cf83}
.cloud-top-status.queued{background:#fff0e8;color:#8b4d20;border-color:#efc2a3}
.cloud-top-status.offline{background:#f1f3f4;color:#59656a;border-color:#cfd6d8}
.cloud-top-status.online{background:#e7f7ee;color:#236447;border-color:#acd8bf}
@media(max-width:760px){.auto-sync-grid{grid-template-columns:1fr 1fr}}
@media(max-width:430px){.auto-sync-grid{grid-template-columns:1fr}}
